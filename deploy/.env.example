# Copy to deploy/.env and replace every value. deploy/.env is ignored by git.

# From @BotFather.
TELEGRAM_BOT_TOKEN=test-token
# Comma-separated telegram_id:display_name pairs. Only these people are served.
ALLOWED_TELEGRAM_USERS=123456789:Example

# Used inside a URL, so keep it URL-safe: openssl rand -hex 32
POSTGRES_PASSWORD=test-password

# Shared by Nestor and LiteLLM. LiteLLM requires the sk- prefix: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-test-key
# Provider keys. They stay inside the LiteLLM container.
GEMINI_API_KEY=test-gemini-key
# Optional unless deploy/litellm.yaml enables an Anthropic model.
ANTHROPIC_API_KEY=

# Optional. Left empty, Nestor uses its defaults:
# LLM_MODEL=cheap, WEB_SEARCH_MODEL=web-search, HISTORY_LIMIT=30, MAX_LOOP_ITERATIONS=8,
# ENABLE_DEMO_TOOLS=false, APPROVAL_TTL=24h, APPROVAL_STALE_AFTER=5m, TIMEZONE=Europe/Zurich.
#
# SYSTEM_PROMPT_FILE is set by deploy/docker-compose.yml to /etc/nestor/system_prompt.md
# (mounting config/system_prompt.md read-only). When running the nestor bot daemon outside
# Compose, set SYSTEM_PROMPT_FILE to a reviewed plain UTF-8 file (at most 4096 bytes).
# CREDENTIALS_KEY encrypts per-user MCP credentials: base64 of 32 random bytes, e.g. `openssl rand -base64 32`.
# Needed only to store credentials with `nestor credentials set`.
CREDENTIALS_KEY=
# ADMIN_USER_ID is the internal user ID (not a Telegram ID) who gets operational alerts, such as an
# MCP tool waiting for `nestor mcp approve`. Unset: alerts are only logged.
ADMIN_USER_ID=
# Optional Google Maps Platform API key for the google-maps MCP server in config/mcp.yaml.
# Unset: google-maps is disabled at startup while other MCP servers keep running.
GOOGLE_MAPS_API_KEY=
# Optional Google OAuth 2.0 client credentials for Google Workspace MCP servers in config/mcp.yaml
# (Contacts, Calendar, Docs, Drive, Universal Search). Unset: those servers are disabled at startup.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LLM_MODEL=
WEB_SEARCH_MODEL=
HISTORY_LIMIT=
MAX_LOOP_ITERATIONS=
ENABLE_DEMO_TOOLS=false
APPROVAL_TTL=
APPROVAL_STALE_AFTER=
TIMEZONE=
