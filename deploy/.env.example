# Copy to deploy/.env and replace every value. deploy/.env is ignored by git.

# From @BotFather.
TELEGRAM_BOT_TOKEN=test-token
# Comma-separated telegram_id:display_name pairs. Only these people are served.
ALLOWED_TELEGRAM_USERS=123456789:Example

# Used inside a URL, so keep it URL-safe: openssl rand -hex 32
POSTGRES_PASSWORD=test-password

# Shared by Nestor and LiteLLM. LiteLLM requires the sk- prefix: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-test-key
# Provider keys. They stay inside the LiteLLM container.
GEMINI_API_KEY=test-gemini-key
# Optional unless deploy/litellm.yaml enables an Anthropic model.
ANTHROPIC_API_KEY=

# Optional. Left empty, Nestor uses its defaults:
# LLM_MODEL=cheap, HISTORY_LIMIT=30, MAX_LOOP_ITERATIONS=8,
# ENABLE_DEMO_TOOLS=false, APPROVAL_TTL=24h, APPROVAL_STALE_AFTER=5m, TIMEZONE=Europe/Zurich.
# CREDENTIALS_KEY encrypts per-user MCP credentials: base64 of 32 random bytes, e.g. `openssl rand -base64 32`.
# Needed only to store credentials with `nestor credentials set`.
CREDENTIALS_KEY=
LLM_MODEL=
HISTORY_LIMIT=
MAX_LOOP_ITERATIONS=
ENABLE_DEMO_TOOLS=false
APPROVAL_TTL=
APPROVAL_STALE_AFTER=
TIMEZONE=
