# Copy to deploy/.env and replace every value. deploy/.env is ignored by git.

# From @BotFather.
TELEGRAM_BOT_TOKEN=test-token
# Comma-separated telegram_id:display_name pairs. Only these people are served.
ALLOWED_TELEGRAM_USERS=123456789:Example

# Used inside a URL, so keep it URL-safe: openssl rand -hex 32
POSTGRES_PASSWORD=test-password

# Shared by Nestor and LiteLLM. LiteLLM requires the sk- prefix: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-test-key
# Provider keys. They stay inside the LiteLLM container.
GEMINI_API_KEY=test-gemini-key
ANTHROPIC_API_KEY=test-anthropic-key

# Optional. Left empty, Nestor uses its defaults: cheap, 30 and 8.
LLM_MODEL=
HISTORY_LIMIT=
MAX_LOOP_ITERATIONS=
